# ── Configuración del servidor (copiar a server/.env) ──
# En producción TODAS estas variables son obligatorias.

# Entorno: production activa cookies Secure y exige los secretos
NODE_ENV=production
PORT=3000

# Secreto para firmar los JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Expiración del access token (formato de jsonwebtoken: 15m, 1h, ...)
ACCESS_TOKEN_TTL=15m
# Vida del refresh token en horas (duración máxima de la sesión)
REFRESH_TOKEN_TTL_HOURS=8

# Credenciales de administrador.
# El hash se genera con: npm run hash-password
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
